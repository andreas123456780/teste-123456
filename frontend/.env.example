# Copy to .env.local (Vite) and fill in. Never commit real secrets.

# API origin. Leave empty ("") in production when the SPA is served by
# the same origin as the Go backend (single-image deploy).
VITE_API_URL=http://localhost:8080

# Stripe publishable key — baked into the bundle at build time. Safe to
# expose. Live keys must start with pk_live_, test keys with pk_test_.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Plausible web analytics — optional. When empty the snippet is NOT
# loaded, so the site ships zero third-party JS. Set both only after
# configuring the domain at https://plausible.io or your self-hosted
# instance.
VITE_PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_SRC=https://plausible.io/js/script.js
